# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Provider Configuration
# Supported providers: demo, openai, gemini, custom
# In demo mode, no API key is required and deterministic local evaluation is used.
AI_PROVIDER=demo

# Real AI Provider Credentials (leave blank to use Demo Mode)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_BASE=
AI_TIMEOUT_SECONDS=25

# Optional Gemini Direct REST Configuration (if AI_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
